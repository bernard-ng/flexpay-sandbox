# Shared sandbox settings
FLEXPAY_PUBLIC_URL=http://localhost:8080
FLEXPAY_MERCHANT=TESTMERCHANT
FLEXPAY_TOKEN=test-token
RUST_LOG=flexpay_sandbox=info

# Published frontend port in Docker Compose
FLEXPAY_PORT=8080

# Native Rust settings; Compose sets these paths and binding inside the container
FLEXPAY_BIND=127.0.0.1:8080
FLEXPAY_DATABASE=data/flexpay.db
FLEXPAY_FRONTEND=frontend/dist/client
