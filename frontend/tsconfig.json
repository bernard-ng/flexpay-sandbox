{
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "lib": ["DOM", "ES2022"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node", "react", "react-dom"]
  },
  "include": ["src", "vite.config.ts"]
}
